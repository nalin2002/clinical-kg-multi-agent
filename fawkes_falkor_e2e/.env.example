HF_TOKEN=hf_...

# Required unless --local-only is used.
OUTPUT_REPO=your-org/fawkes-falkor-e2e-artifacts

# Raw admission source.
RAW_REPO=on1onmangoes/fawkes-mimic-megaflat-admission-260615
RAW_FILE=fawkes_mimic_megaflat_admission_260615.jsonl
# Optional local development override.
# RAW_LOCAL_FILE=/path/to/raw_admissions.jsonl
N_PATIENTS=1000
SEED=42

# LLM edge extraction endpoint.
LLM_MODE=required
ENDPOINT_URL=https://YOUR-ENDPOINT
EDGE_MODEL=google/medgemma-27b-text-it
WORKERS=16
MAX_NEW_TOKENS=15000

# Optional note embedding stage. This writes kg_embedded.jsonl.
EMBED_NOTES=1
EMBED_MODEL=Simonlee711/Clinical_ModernBERT
EMBED_MAX_LEN=8192
EMBED_BATCH_SIZE=32
EMBED_DEVICE=cuda
# Store note_embedding arrays on KGGraph during Falkor upload.
INCLUDE_NOTE_EMBEDDING=1

# FalkorDB target.
FALKORDB_URL=redis://USER:PASSWORD@HOST:PORT
FALKORDB_GRAPH=fawkes_clinical_kg
FALKOR_BATCH_SIZE=50

# QA against the uploaded Falkor graph.
QA_PROVIDER=auto
# Optional chat-completions-compatible QA endpoint. Defaults to ENDPOINT_URL if set.
# QA_ENDPOINT_URL=https://YOUR-QA-ENDPOINT
QA_ENDPOINT_TOKEN_ENV=HF_TOKEN
QA_MODEL=z-ai/glm-4.7-flash
QA_MAX_TOKENS=1200
QA_TEMPERATURE=0
QA_RETRIEVER=lexical
# For --retriever embedding, install sentence-transformers.
QA_EMBEDDING_MODEL=BAAI/bge-m3
OPENROUTER_MODEL=z-ai/glm-4.7-flash
# OPENROUTER_API_KEY=...
OLLAMA_API_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=glm-4.7-flash
